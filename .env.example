# Runtime
NODE_ENV=development
PORT=3000
APP_ID=property-dashboard

# Database (MySQL)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/property_dashboard

# Auth / Session
JWT_SECRET=replace-with-a-long-random-string
